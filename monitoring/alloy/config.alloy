// OpenLMIS Malawi host agent: discover app containers, collect host/container
// metrics, tail logs, push to /ingest/*. Env-configured; adds an `environment` label.
// Kept in sync with soldevelo-monitoring/agents-alloy/config.alloy — diff before editing.
// Deliberate divergence: the nginx file-log tailing and the scalyr drop below are
// OpenLMIS-specific (no scalyr container, no file-logging nginx on sdd/ilo).

// metrics: app containers (docker SD)

discovery.docker "app" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "app" {
  targets = discovery.docker.app.targets

  rule {
    source_labels = ["__meta_docker_container_label_monitoring_scrape"]
    regex         = "true"
    action        = "keep"
  }
  rule {
    source_labels = ["__meta_docker_network_ip", "__meta_docker_container_label_monitoring_port"]
    separator     = ":"
    target_label  = "__address__"
  }
  rule {
    source_labels = ["__meta_docker_container_label_monitoring_path"]
    regex         = "(.+)"
    target_label  = "__metrics_path__"
  }
  rule {
    source_labels = ["__meta_docker_container_label_monitoring_service"]
    target_label  = "service"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "instance"
  }
}

// `job` is the package's collector-kind contract — app / node / cadvisor /
// agent — and alert rules key on it. Service identity lives in `service`, not
// here. Never let it default to the Alloy component name: rules would then be
// pinned to this file's internal structure. See docs/metrics.md.
prometheus.scrape "app" {
  targets         = discovery.relabel.app.output
  forward_to      = [prometheus.remote_write.central.receiver]
  job_name        = "app"
  scrape_interval = "15s"
}

// metrics: host + containers
//
// prometheus.exporter.* components preset `job` on their own targets
// (`integrations/unix`, `integrations/cadvisor`), and Prometheus only applies
// a scrape's job_name when the target's job label is empty — so the kind label
// has to be rewritten here, not on the scrape.

prometheus.exporter.unix "host" {
  rootfs_path = "/host/root"
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
}

discovery.relabel "host" {
  targets = prometheus.exporter.unix.host.targets

  rule {
    target_label = "job"
    replacement  = "node"
  }
}

prometheus.scrape "host" {
  targets    = discovery.relabel.host.output
  forward_to = [prometheus.remote_write.central.receiver]
}

prometheus.exporter.cadvisor "containers" {
  docker_host = "unix:///var/run/docker.sock"
}

discovery.relabel "cadvisor" {
  targets = prometheus.exporter.cadvisor.containers.targets

  rule {
    target_label = "job"
    replacement  = "cadvisor"
  }
}

prometheus.scrape "cadvisor" {
  targets    = discovery.relabel.cadvisor.output
  forward_to = [prometheus.remote_write.central.receiver]
}

// metrics: the agent itself
//
// The heartbeat AgentAbsent keys on. In a push model a dead host cannot report
// itself down — its series simply stop arriving — so this is what makes the
// absence detectable centrally.

prometheus.exporter.self "agent" {}

discovery.relabel "agent" {
  targets = prometheus.exporter.self.agent.targets

  rule {
    target_label = "job"
    replacement  = "agent"
  }
}

prometheus.scrape "agent" {
  targets    = discovery.relabel.agent.output
  forward_to = [prometheus.remote_write.central.receiver]
}

prometheus.remote_write "central" {
  endpoint {
    url          = sys.env("INGEST_METRICS_URL")
    bearer_token = sys.env("INGEST_TOKEN")
  }
  external_labels = {
    app         = sys.env("APP"),
    deployment  = sys.env("DEPLOYMENT"),
    environment = sys.env("ENVIRONMENT"),
    host        = sys.env("TARGET_NAME"),
  }
}

// logs

discovery.docker "logs" {
  host = "unix:///var/run/docker.sock"
}

discovery.relabel "logs" {
  targets = discovery.docker.logs.targets

  // drop the agent's own logs (feedback loop)
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_project"]
    regex         = "soldevelo-monitoring-agents"
    action        = "drop"
  }

  // drop the DataSet/Scalyr shipper's own stdout: ~385 lines/min, of which 99.6%
  // is a failing dfstat.py tcollector plugin printing its usage text at WARNING.
  // Dropped here, so it never leaves the host. Goes away with the DataSet sunset.
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    regex         = "scalyr"
    action        = "drop"
  }
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label  = "container"
  }
  rule {
    source_labels = ["__meta_docker_container_label_monitoring_service"]
    target_label  = "service"
  }
  rule {
    target_label = "app"
    replacement  = sys.env("APP")
  }
  rule {
    target_label = "deployment"
    replacement  = sys.env("DEPLOYMENT")
  }
  rule {
    target_label = "environment"
    replacement  = sys.env("ENVIRONMENT")
  }
  rule {
    target_label = "host"
    replacement  = sys.env("TARGET_NAME")
  }
}

loki.source.docker "containers" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.logs.output
  forward_to = [loki.write.central.receiver]
}

// logs: nginx access/error
//
// The reverse proxy writes to files in the `nginx-log` volume (NGINX_LOG_DIR) and
// nothing to stdout, so loki.source.docker above never sees it — the one stream
// DataSet carried that Loki did not. Read through the /var/lib/docker mount that
// is already there for cAdvisor, so this needs no compose or alloy.env change.
// `filename` (set by loki.source.file) separates access.log from error.log.

local.file_match "nginx" {
  path_targets = [{
    __path__    = "/var/lib/docker/volumes/*_nginx-log/_data/*.log",
    container   = "nginx",
    service     = "nginx",
    app         = sys.env("APP"),
    deployment  = sys.env("DEPLOYMENT"),
    environment = sys.env("ENVIRONMENT"),
    host        = sys.env("TARGET_NAME"),
  }]
}

loki.source.file "nginx" {
  targets    = local.file_match.nginx.targets
  forward_to = [loki.process.nginx.receiver]
  // access.log is never rotated (400 MB+ on dev); without this the first start
  // backfills every historical line.
  tail_from_end = true
}

loki.process "nginx" {
  forward_to = [loki.write.central.receiver]

  // ELB health checks are ~34k/day/env of `GET / 200` — near enough all of the
  // access log on a quiet env. Availability is covered by the blackbox probes.
  stage.drop {
    expression          = "ELB-HealthChecker"
    drop_counter_reason = "nginx_health_check"
  }
}

loki.write "central" {
  endpoint {
    url          = sys.env("INGEST_LOGS_URL")
    bearer_token = sys.env("INGEST_TOKEN")
  }
}
