# Copy to .env and fill in. Do NOT commit .env (see .gitignore).

# Grafana Alloy image version
ALLOY_VERSION=v1.5.1

# Keep this stable — config.alloy drops the agent's own logs by this project name.
COMPOSE_PROJECT_NAME=soldevelo-monitoring-agents

# --- Identity labels (see soldevelo-monitoring docs/metrics.md) ---
APP=openlmis
DEPLOYMENT=malawi
# environment distinguishes UAT from Prod on the shared monitoring host
ENVIRONMENT=uat
# per-host label; distinguishes this host from other hosts of the same deployment
TARGET_NAME=malawi-uat

# --- App docker network to join, so Alloy can reach container IPs to scrape ---
# Confirm the real name on the host:  docker network ls
# (docker-compose v1 names it <project>_default; the uat_env stack -> uatenv_default)
APP_NETWORK=uatenv_default

# --- Central ingest endpoints (bearer-gated Caddy paths on the monitoring host) ---
INGEST_METRICS_URL=https://olmismalawi-monitoring.soldevelo.com/ingest/prometheus/api/v1/write
INGEST_LOGS_URL=https://olmismalawi-monitoring.soldevelo.com/ingest/loki/loki/api/v1/push

# Bearer token — MUST equal INGEST_TOKEN in the monitoring host's .env.
# Supply the real value via the private config repo / Jenkins credentials; never commit it.
INGEST_TOKEN=__set_via_secret__
